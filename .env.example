# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS Gateway — "SMS Gateway for Android" (capcom6) running in Cloud mode on
# the school's phone (github.com/capcom6/android-sms-gateway, or F-Droid/
# IzzyOnDroid — not on the Play Store). Open the app > Settings tab > under
# Credentials, copy Username/Password (auto-generated on first "START
# SERVICE" in Cloud mode). Leave SMS_GATEWAY_URL unset unless self-hosting.
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# Email (SMTP) — used to send the generated password when a parent creates
# their child's account. Optional: without it, the password is still shown
# on screen once. Using Brevo (free tier, 300 emails/day) as a stand-in
# until the school's real contact@cpkef.tn mailbox + VPS are ready — swap
# these 5 values later without any code change.
# Brevo dashboard > Settings (gear icon) > SMTP & API > SMTP tab — the
# server/port/login are shown there; the password is the "SMTP key" (click
# "Generate a new SMTP key" if none exists yet, shown once).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=a4a8f4001@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM=mouka3112goat@gmail.com

# Konnect (konnect.network) — passerelle de paiement tunisienne, utilisée
# pour la page "Faire un don" (/dons).
# 1. Crée un compte sur https://dashboard.konnect.network (et un compte de
#    test séparé sur https://dashboard.sandbox.konnect.network si tu veux
#    tester avant de passer en réel).
# 2. Dans le dashboard, l'ID de portefeuille (wallet ID) est affiché sur la
#    page d'accueil ; la clé API est sous Developers > API Keys.
# 3. KONNECT_SANDBOX=true tant que tu testes ; passe à false (ou supprime la
#    ligne) une fois prêt à recevoir de vrais paiements.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=true

# Cron — protège /api/cron/suggestions (tirage mensuel de l'idée gagnante).
# Vercel envoie automatiquement `Authorization: Bearer $CRON_SECRET` pour ses
# invocations planifiées (voir vercel.json) dès que cette variable existe côté
# Vercel — génère une valeur aléatoire et mets-la aussi dans Project Settings
# > Environment Variables sur Vercel.
CRON_SECRET=

# Assistant IA (Gemini) — clé gratuite sur https://aistudio.google.com/apikey
# (aucune carte bancaire requise). Sans clé, la bulle de chat affiche un
# message "assistant indisponible" au lieu de planter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Notifications push (web + Android) — nécessite un projet Firebase gratuit
# (console.firebase.google.com). Sans ces clés, les notifications restent
# disponibles uniquement sur le site (cloche 🔔), sans miroir push.
#
# 1. Crée un projet Firebase (gratuit, plan Spark suffit).
# 2. Project settings > Cloud Messaging > active l'API si besoin.
# 3. Project settings > Comptes de service > "Générer une nouvelle clé
#    privée" > télécharge le JSON, et remplis les 3 variables ci-dessous
#    avec project_id / client_email / private_key (garde les \n dans la clé).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Project settings > Général > ajoute une app Web (</>) si pas déjà fait,
#    copie la config qui s'affiche dans les 6 variables NEXT_PUBLIC_ ci-dessous.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 5. Project settings > Cloud Messaging > "Web configuration" > "Generate
#    key pair" (clé VAPID) > colle-la ici.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 6. Recopie les 6 valeurs NEXT_PUBLIC_FIREBASE_* ci-dessus dans
#    public/firebase-messaging-sw.js (fichier statique, ne peut pas lire
#    ces variables — voir le commentaire en haut de ce fichier).
#
# 7. Pour l'app Android : ajoute une app Android dans Firebase avec le
#    package "tn.cpkef.app", télécharge google-services.json, et donne-le
#    moi pour que je finisse le câblage natif (Gradle) + recompile l'APK.
