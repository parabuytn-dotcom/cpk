# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS Gateway — URL of the local Android "SMS Gateway" app (or equivalent)
# receiving { to, message, from } as JSON via POST and sending through the
# phone registered with SIM number 99766801.
SMS_GATEWAY_URL=http://192.168.1.10:8080/send
SMS_GATEWAY_TOKEN=change-me
SMS_SENDER_NUMBER=99766801

# Email (SMTP) — used to send the generated password when a parent creates
# their child's account. Works with any SMTP account (e.g. the mailbox
# bundled with an OVH domain). Optional: without it, the password is still
# shown on screen once.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=contact@cpkef.tn
SMTP_PASSWORD=
SMTP_FROM=contact@cpkef.tn

# Assistant IA (Gemini) — clé gratuite sur https://aistudio.google.com/apikey
# (aucune carte bancaire requise). Sans clé, la bulle de chat affiche un
# message "assistant indisponible" au lieu de planter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
