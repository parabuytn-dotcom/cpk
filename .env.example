# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS Gateway — URL of the local Android "SMS Gateway" app (or equivalent)
# receiving { to, message, from } as JSON via POST and sending through the
# phone registered with SIM number 99766801.
SMS_GATEWAY_URL=http://192.168.1.10:8080/send
SMS_GATEWAY_TOKEN=change-me
SMS_SENDER_NUMBER=99766801

# Email (Brevo) — used to send the generated password when a parent creates
# their child's account. Optional: without it, the password is still shown
# on screen once.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@cpkef.tn
